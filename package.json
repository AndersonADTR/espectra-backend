{
  "name": "espectra-backend",
  "version": "1.0.0",
  "description": "Backend service for Spectra platform",
  "main": "index.js",
  "scripts": {
    "start": "serverless offline",
    "deploy": "serverless deploy",
    "deploy:prod": "serverless deploy --stage prod",
    "deploy:kms": "serverless deploy -c serverless-kms.yml",
    "deploy:sns": "serverless deploy -c serverless-sns.yml",
    "deploy:cognito": "serverless deploy -c serverless-cognito.yml",
    "deploy:phase1": "serverless deploy -c serverless-phase1.yml",
    "deploy:phase2": "serverless deploy -c serverless-phase2.yml",
    "deploy:phase3": "serverless deploy -c serverless-phase3.yml",
    "deploy:phase4": "serverless deploy -c serverless-phase4.yml",
    "deploy:phase5": "serverless deploy -c serverless-phase5.yml",
    "deploy:all": "npm run deploy:kms && npm run deploy:sns && npm run deploy:cognito && npm run deploy:phase1 && npm run deploy:phase2 && npm run deploy:phase3 && npm run deploy:phase4 && npm run deploy:phase5",
    "remove": "serverless remove",
    "build": "tsc",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write '**/*.{ts,js,json,md}'",
    "type-check": "tsc --noEmit",
    "clean": "rimraf node_modules package-lock.json .build .serverless",
    "prepare": "husky install",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "services/**/*.ts",
      "!services/**/*.d.ts"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-api-gateway": "^3.465.0",
    "@aws-sdk/client-apigatewaymanagementapi": "^3.465.0",
    "@aws-sdk/client-cloudwatch": "^3.465.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.465.0",
    "@aws-sdk/client-dynamodb": "^3.465.0",
    "@aws-sdk/client-elasticache": "^3.465.0",
    "@aws-sdk/client-eventbridge": "^3.465.0",
    "@aws-sdk/client-kms": "^3.465.0",
    "@aws-sdk/client-secrets-manager": "^3.465.0",
    "@aws-sdk/client-ses": "^3.465.0",
    "@aws-sdk/client-sns": "^3.465.0",
    "@aws-sdk/client-sqs": "^3.465.0",
    "@aws-sdk/client-ssm": "^3.465.0",
    "@aws-sdk/client-wafv2": "^3.465.0",
    "@aws-sdk/lib-dynamodb": "^3.465.0",
    "@aws-sdk/util-dynamodb": "^3.465.0",
    "@botpress/sdk": "^1.6.2",
    "@middy/core": "^4.6.5",
    "@smithy/middleware-retry": "^2.0.12",
    "@smithy/protocol-http": "^3.0.10",
    "@smithy/smithy-client": "^2.1.15",
    "@smithy/util-middleware": "^2.0.9",
    "@smithy/util-retry": "^2.0.9",
    "@types/redis": "^4.0.11",
    "aws-jwt-verify": "^4.0.0",
    "aws-xray-sdk": "^3.5.3",
    "aws-xray-sdk-core": "^3.5.3",
    "axios": "^1.6.2",
    "dotenv": "^16.3.1",
    "fast-xml-parser": "^4.3.2",
    "googleapis": "^129.0.0",
    "ioredis": "^5.3.2",
    "joi": "^17.11.0",
    "js-yaml": "^4.1.0",
    "mnemonist": "^0.39.5",
    "redis": "^4.6.11",
    "serverless-plugin-tracing": "^2.0.0",
    "strnum": "^1.0.5",
    "tslib": "^2.6.2",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.126",
    "@types/jest": "^29.5.10",
    "@types/node": "^20.11.30",
    "@types/uuid": "^9.0.7",
    "@types/winston": "^2.4.4",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "lint-staged": "^15.1.0",
    "prettier": "^3.1.0",
    "rimraf": "^5.0.5",
    "serverless": "^4.9.1",
    "serverless-domain-manager": "^8.0.0",
    "serverless-iam-roles-per-function": "^3.2.0",
    "serverless-offline": "^14.0.0",
    "serverless-prune-plugin": "^2.1.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "keywords": [
    "serverless",
    "aws",
    "typescript",
    "lambda"
  ],
  "author": "",
  "license": "ISC"
}
